# GrowStreams API environment template
# Copy this file to .env and replace placeholder values before running the API.

# Server
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=*

# Vara network
VARA_NODE=wss://testnet.vara.network
VARA_SEED=replace_with_local_development_seed_phrase

# Deployed Vara program IDs
GROW_TOKEN_ID=0x05a2a482f1a1a7ebf74643f3cc2099597dac81ff92535cbd647948febee8fe36
STREAM_CORE_ID=0x2e7c2064344449504c9c638261bab78238ae50b8a47faac5beae2d1915d70a56
TOKEN_VAULT_ID=0x7e081c0f82e31e35d845d1932eb36c84bbbb50568eef3c209f7104fabb2c254b
SPLITS_ROUTER_ID=0xe4fe59166d824a0f710488b02e039f3fe94980756e3571fc93ba083b5b88b894
PERMISSION_MANAGER_ID=0x6cce66023765a57cbc6adf5dfe7df66ee636af56ab7d92a8f614bd8c229f88cb
BOUNTY_ADAPTER_ID=0xd5377611a285d3efcbe9369361647d13f3a9c60ed70d648eaa21c08c72268f81
IDENTITY_REGISTRY_ID=0xb6389d1da594b84a73f3a5178caa25ff56ec0f57f2f8a9d42f8b1b6fba9d948a

# Campaign admin/auth
ADMIN_SECRET=replace_with_strong_admin_secret
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret
GITHUB_TOKEN=replace_with_github_token_for_campaign_scoring
GITHUB_APP_PRIVATE_KEY=replace_with_github_app_private_key_if_used
GITHUB_REPO_OWNER=BlockX-AI
GITHUB_REPO_NAME=GrowStreams_Backend

# AI scoring
OPENAI_API_KEY=replace_with_openai_api_key
LLM_MODEL=gpt-4o-mini
SCORE_THRESHOLD=70

# Campaign dates and rewards
CAMPAIGN_START_DATE=2026-01-01T00:00:00.000Z
CAMPAIGN_END_DATE=2026-12-31T23:59:59.000Z
CAMPAIGN_POOL_USDC=500
OSS_XP_70=700
OSS_XP_80=1200
OSS_XP_90=2000
OSS_DAILY_70=100
OSS_DAILY_80=150
OSS_DAILY_90=200
CONTENT_XP_70=500
CONTENT_XP_80=800
CONTENT_XP_90=1200
MERGE_BONUS_XP=500

# Twitter/X content scoring (optional unless content campaign is enabled)
X_API_KEY=replace_with_x_api_key
X_API_SECRET=replace_with_x_api_secret
X_ACCESS_TOKEN=replace_with_x_access_token
X_ACCESS_SECRET=replace_with_x_access_secret
X_BEARER_TOKEN=replace_with_x_bearer_token

# Database / hosted services (if enabled by deployment)
DATABASE_URL=replace_with_database_url
DB_SSL=false
SUPABASE_URL=replace_with_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
